# ===== WAJIB =====
# API key Google Gemini. Ambil di: https://aistudio.google.com/app/apikey
# Formatnya diawali "AIza" (sekitar 39 karakter).
GEMINI_API_KEY=

# ===== OPSIONAL =====
# Port server (default: 3000)
PORT=3000

# Model Gemini yang dipakai (default: gemini-3.1-flash-lite)
GEMINI_MODEL=gemini-3.1-flash-lite

# Prompt default yang dipakai kalau mengirim lampiran tanpa teks
DEFAULT_PROMPT=Jelaskan isi lampiran ini.

# Batas ukuran tiap file dalam MB (default: 5)
MAX_FILE_SIZE_MB=5

# Maksimal jumlah file per request (default: 5)
MAX_FILES=5

# Instruksi sistem: peran & batasan model (default lihat index.js)
SYSTEM_INSTRUCTION=Kamu adalah asisten AI yang ramah dan membantu. Jawab dengan jelas, ringkas, dan akurat. Gunakan bahasa Indonesia kecuali pengguna memakai bahasa lain. Tolak dengan sopan permintaan yang tidak pantas atau di luar topik.
